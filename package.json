{
  "name": "szabmu-oes",
  "private": true,
  "version": "0.1.0",
  "description": "SZABMU / PIMS Online Examination System",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @oes/shared",
    "build:web": "npm run build:shared && npm run build -w @oes/web",
    "build:api": "npm run build:shared && npm run build -w @oes/api",
    "start:web": "npm run start -w @oes/web",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/api/dist/worker.js",
    "reconcile": "npm run reconcile -w @oes/api",
    "build": "npm run build:shared && npm run build -w @oes/api && npm run build -w @oes/web",
    "typecheck": "npm run build:shared && npm run typecheck -w @oes/api && npm run typecheck -w @oes/web",
    "lint": "eslint .",
    "db:migrate": "npm run db:migrate -w @oes/api",
    "db:seed": "npm run db:seed -w @oes/api",
    "dev:api": "npm run dev -w @oes/api",
    "dev:web": "npm run dev -w @oes/web",
    "test": "npm run build:shared && npm run test -w @oes/shared && npm run test -w @oes/api",
    "test:e2e": "playwright test",
    "test:load": "node --env-file=.env tests/load/exam-load.mjs",
    "test:fault": "npm run build:shared && npm run test:fault -w @oes/api",
    "backup:db": "node scripts/db-backup.mjs backup",
    "backup:verify": "node scripts/db-backup.mjs verify",
    "start:hostinger": "node scripts/hostinger-single-site.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.0.0",
    "mariadb": "^3.5.4",
    "pg": "^8.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "undici": "^8.12.3"
  },
  "allowScripts": {
    "@swc/core@1.16.21": true,
    "argon2@0.45.1": true,
    "prisma@7.10.1": true,
    "msgpackr-extract@3.0.4": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "fastify": "^5.12.7"
  }
}
