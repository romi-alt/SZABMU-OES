# Copy to .env — values below are DEVELOPMENT ONLY. Never reuse in production.
NODE_ENV=development
DATABASE_URL=postgresql://oes:oes_dev_password@localhost:5433/szabmu_oes
TEST_DATABASE_URL=postgresql://oes:oes_dev_password@localhost:5433/szabmu_oes_test
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
COOKIE_SECRET=dev-only-cookie-secret-change-me-0123456789
RECEIPT_SECRET=dev-only-receipt-secret-change-me-0123456789
SESSION_TTL_HOURS=12
# S3-compatible object storage (MinIO in docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oes-artifacts
S3_ACCESS_KEY=oes_dev_minio
S3_SECRET_KEY=oes_dev_minio_secret
# SMTP (Mailpit in docker-compose). Leave SMTP_HOST empty to keep mail in the DB outbox only.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="SZABMU Examinations <exams@szabmu.example>"
# Exposes /dev/* helpers and returns reset codes in API responses. MUST be false outside local dev.
DEV_EXPOSE_CODES=true
