# Copy to api.env on the VPS (mode 600). Never commit the real file. Every <...> must be replaced; the API refuses to boot with example values.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000

# Both public origins (CSRF origin allow-list; session cookies are Secure). Exactly these two, https only.
WEB_ORIGIN=https://oes.szabmu.site,https://dashboard.szabmu.site
# nginx is the only client of this process: trust its X-Forwarded-For (rate limits and audit use the real client IP) and its X-OES-Portal header.
TRUST_PROXY=true
PORTAL_ENFORCE=true

# Database: private Docker network, TLS on (sslmode=require). Same password as postgres.env.
DATABASE_URL=postgresql://oes:<POSTGRES_PASSWORD>@postgres:5432/szabmu_oes?sslmode=require
DB_POOL_MAX=20
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# Distinct random secrets, >= 32 chars each:  openssl rand -base64 48
COOKIE_SECRET=<generate>
RECEIPT_SECRET=<generate>
MFA_KEY=<generate>
METRICS_TOKEN=<generate: >= 24 chars>
MFA_ENFORCE=true
SESSION_TTL_HOURS=12

# Never true in production (returns password-reset codes in API responses).
DEV_EXPOSE_CODES=false
RUN_WORKERS=true

# Real mail is REQUIRED so candidates can recover passwords. Authenticated SMTP is supported (SMTP_USER/SMTP_PASS; TLS with a verified
# certificate is then always enforced). Hostinger mailbox: smtp.hostinger.com, port 465 (implicit TLS) or 587 (STARTTLS).
# MAIL_FROM must use the authenticated mailbox's address. SPF/DKIM/DMARC for szabmu.site are required.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@szabmu.site
SMTP_PASS=<mailbox password — set only in hPanel>
MAIL_FROM="SZABMU Examinations <no-reply@szabmu.site>"
